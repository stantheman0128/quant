# 複製本檔為 .env，填入真實 key 後使用。.env 已在 .gitignore，不會推上 git。

# === Apify ===
# https://console.apify.com/settings/integrations
# 用於 Facebook posts 抓取
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === LLM（任選一組） ===
# 預設用 Anthropic Claude Haiku 4.5（最穩，每集 ~$0.06）
ANTHROPIC_API_KEY=sk-ant-xxx

# 或：DeepInfra 上的開源 LLM（同 banini-tracker 預設，每集 ~$0.01）
# LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# LLM_API_KEY=your_deepinfra_key
# LLM_MODEL=MiniMaxAI/MiniMax-M2.5

# 或：OpenAI gpt-4o-mini（每集 ~$0.02）
# LLM_BASE_URL=https://api.openai.com/v1/
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# === FinMind（免費，註冊取 token 可提高額度） ===
# 用於台股價格查詢
FINMIND_TOKEN=
